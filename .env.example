HOST=127.0.0.1
PORT=3210
# Use a shared server for team access. Configure HTTPS with a reverse proxy.
# APP_ORIGIN=https://your-internal-domain.example
# Railway uses https://RAILWAY_PUBLIC_DOMAIN automatically when APP_ORIGIN is unset.
# Set APP_ORIGIN to the exact public origin for other proxies or a custom domain.
# HTTPS origins automatically use secure session cookies.
# COOKIE_SECURE=true
# DATA_DIR=.data
# Shared PostgreSQL database. Set the same value locally and on Railway.
# Supabase: use the Session pooler (port 5432), not the project HTTPS URL.
# Keep credentials only in .env or Railway Variables; never commit them.
# DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@POOLER_HOST:5432/postgres
# DATABASE_SCHEMA=sgu
# Without DATABASE_URL, the existing local SQLite database is used.
# Optional local MinerU executable (no remote upload).
# MINERU_BIN=D:/AI-Yang.cn/tools/mineru/uv-tools/mineru/Scripts/mineru.exe
# MINERU_HOME=D:/AI-Yang.cn/tools/mineru/data
# Optional OpenAI-compatible language model. All three values are required.
# LLM_BASE_URL=https://your-provider.example/v1
# LLM_API_KEY=
# LLM_MODEL=
